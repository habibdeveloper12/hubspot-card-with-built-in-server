{
  "name": "CRM Data Components App",
  "description": "This is a private app that shows 2 custom cards. It demonstrates usages of CRM Components",
  "uid": "crm_data_components_app",
  "scopes": [
    "crm.objects.contacts.read",
    "crm.objects.contacts.write",
    "crm.objects.deals.write",
    "crm.objects.deals.read",
    "crm.schemas.contacts.read",
    "crm.schemas.deals.read",
    "crm.objects.companies.read",
    "crm.objects.companies.write",
    "crm.schemas.companies.read",
    "crm.objects.custom.read",
    "crm.schemas.custom.read",
    "crm.schemas.custom.write"
  ],
  "public": false,
  "extensions": {
    "crm": {
      "cards": [
        {
          "file": "extensions/stage-tracker-example-card.json"
        },
        {
          "file": "extensions/association-table-example-card.json"
        },
        {
          "file": "extensions/unit-enrolments-with-workshops-card.json"
        },
        {
          "file": "extensions/contact-association-tab.json"
        },
        {
          "file": "extensions/unit-competency-workshop.json"
        },
        {
          "file": "extensions/workshop-with-unit-enrollment.json"
        },
        {
          "file": "extensions/workshop-enrollments-tab.json"
        }
      ]
    }
  }
}
